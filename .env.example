# ── scrape-flow environment configuration ────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Application
DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=              # Set to enable bearer-token auth (leave blank to disable)

# Scraping engine
MAX_CONCURRENCY=10
REQUEST_TIMEOUT=30
DEFAULT_RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=1.5
RESPECT_ROBOTS_TXT=true

# Rate limiting
RATE_LIMIT_PER_SECOND=2.0
RATE_LIMIT_BURST=5

# Proxy rotation (full integration available on request)
PROXY_PROVIDER_URL=
PROXY_API_KEY=

# Storage
DATABASE_URL=sqlite+aiosqlite:///./scrape_flow.db
REDIS_URL=redis://localhost:6379/0
